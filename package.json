{
  "name": "night-cards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm run dev -w @nc/server\" \"npm run dev -w @nc/web\"",
    "build": "npm run build -w @nc/shared && npm run build -w @nc/web && npm run build -w @nc/server && node scripts/copy-web.mjs",
    "start": "node apps/server/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "icons": "node scripts/gen-icons.mjs",
    "prepare": "husky || true",
    "cards:template": "node scripts/gen-cards-template.mjs",
    "cards:check": "tsx scripts/check-cards.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "~5.7",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
