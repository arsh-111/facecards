# Copy to .env for local overrides. Never commit .env.
NODE_ENV=development
PORT=3000
# Leave DATABASE_URL empty in dev/test to use embedded PGlite (.data/pglite).
DATABASE_URL=
REDIS_URL=
FEATURE_REDIS_ADAPTER=0
SESSION_HASH_SECRET=change-me-to-32-plus-random-bytes
ALLOWED_ORIGIN=http://localhost:5173
SESSION_IDLE_HOURS=3
SESSION_ABSOLUTE_HOURS=24
ROOM_IDLE_HOURS=6
